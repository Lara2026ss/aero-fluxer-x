# Configuración del Gateway en Render
PORT=3000
FEEDBACK_RATE_LIMIT=10
FEEDBACK_MAX_PAYLOAD_MB=3

# Firebase Realtime Database
FIREBASE_DATABASE_URL=https://tu-proyecto-default-rtdb.firebaseio.com
FIREBASE_AUTH_TOKEN=tu_token_o_secret_de_firebase

# Digest y Notificaciones para el Mantenedor (Email Digest periódico)
FEEDBACK_NOTIFICATION_EMAIL=admin@tudominio.com
RESEND_API_KEY=re_tu_api_key_de_resend

# Clave administrativa privada para consultar métricas
ADMIN_SECRET_KEY=clave_secreta_super_segura
