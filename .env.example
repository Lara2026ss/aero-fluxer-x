# ══════════════════════════════════════════════════════════════════
# Aero Fluxer X — Environment Variables Template (.env.example)
# Copie este archivo como .env si desea sobrescribir configuraciones.
# NUNCA guarde contraseñas ni tokens reales en el repositorio público.
# ══════════════════════════════════════════════════════════════════

# Directorio de datos del usuario (Opcional - por defecto usa %APPDATA%/AeroFluxerX en Windows o ~/.config/aero-fluxer-x en Linux)
# AERON_DATA_DIR=C:\Users\mi-usuario\AppData\Roaming\AeroFluxerX

# Puerto HTTP del Dashboard / API local (por defecto: 8765)
AERON_HTTP_PORT=8765

# Modo de seguridad: SAFE | NORMAL | ELEVATED (por defecto: NORMAL)
AERON_SECURITY_MODE=NORMAL

# Confianza en cliente MCP: true | false
AERON_TRUSTED_CLIENT=false

# Nivel de log: debug | info | warn | error
AERON_LOG_LEVEL=info

# Concurrencia de la cola de tareas
AERON_CONCURRENCY=4
AERON_QUEUE_MAX=250

# Aero Fluxer X es 100% autónomo y desacoplado: no requiere tokens ni conexiones a servicios externos.
